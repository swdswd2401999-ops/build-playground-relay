# ── 监听与认证 ────────────────────────────────────────────
# 只监听回环。要对外用，走 nginx 反代，不要直接改 0.0.0.0
LISTEN_ADDR=127.0.0.1:2048
# 下游调用方用的 key，自己生成足够长的随机串
PROXY_API_KEY=sk-replace-with-47-random-chars
# 管理 API 免登录仅在 LISTEN_ADDR 是回环时安全。暴露公网前必须改 true
ADMIN_AUTH_ENABLED=false

# ── 账号 ──────────────────────────────────────────────────
AISTUDIO_AUTH_STATES=auth
AUTO_START=true

# ── 后端 ──────────────────────────────────────────────────
# go      = 纯 Go，不起浏览器（约 350MB / 4 账号）
# camoufox = 起真浏览器（约 700MB / 账号），只在调试指纹时用
WAA_BACKEND=go

# 双通道。顺序影响默认优先级，但 BUILD_NATIVE_NONSTREAM=true 会覆盖非流式请求
UPSTREAM_CHANNELS=build,playground
# true  = 非流式优先走 Build（ProxyUnaryCall，原生非流式，约 3s）
# false = 严格按 UPSTREAM_CHANNELS，非流式会走 Playground（流式收集后转非流式，约 22s+）
BUILD_NATIVE_NONSTREAM=true
ROUTING_STRATEGY=round-robin

# ── 并发 ──────────────────────────────────────────────────
# 单账号同时执行的请求数。配额按「账号 + 模型」计，调高只会更快撞 429
PER_ACCOUNT_CONCURRENCY=2
# 常驻预热账号数 = 可用账号数
WARM_WORKER_LIMIT=2
# 按需扩容上限，建议 = 2 × 可用账号数
MAX_ACTIVE_WORKERS=4
WARM_STARTUP_CONCURRENCY=2

# ── 超时与日志 ────────────────────────────────────────────
# 默认 30m 偏大，会和反向代理的 read timeout 打架
REQUEST_TIMEOUT=10m
LOG_FILE=true
LOG_MAX_TOTAL_MB=200

# ── 出口 ──────────────────────────────────────────────────
# 留空 = 直连。填了就是全局出口；单账号出口在管理界面单独设
PROXY=

# ── 看门狗（不由程序读取，由 watchdog/ 使用）───────────────
# 必须选业务不用的模型，否则每 5 分钟一次的探针会吃掉日配额
WATCHDOG_PROBE_MODEL=gemini-3-flash-preview
